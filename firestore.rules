rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    // GÜVENLİK NOTLARI (30.08.2026 sertleştirmesi)
    // ==========================================================
    // 1) Hiçbir koleksiyonda "allow write: if request.auth != null" catch-all
    //    kuralı YOKTUR. Firestore izinleri OR'lar; böyle bir satır üstündeki
    //    tüm dar kuralları geçersiz kılıyordu (herkes herkesin dokümanını
    //    yazabiliyor, elmas/premium defteri istemciden uydurulabiliyordu).
    // 2) `password_reset_codes` tamamen kapalıdır — yalnızca Admin SDK
    //    (Cloud Functions) yazar/okur. Eskiden dünyaya açıktı ve
    //    resetUserPassword ile birlikte kimlik doğrulamasız hesap ele
    //    geçirmeye izin veriyordu.
    // 3) `users` artık oturum açmadan okunamaz. Uygulama içi tüm profil
    //    okumaları oturum açmış kullanıcı tarafından yapıldığı için bu
    //    davranışı bozmaz; dışarıdan toplu PII toplamayı engeller.
    // 4) Sorgu (list) izinleri, istemcinin gerçekten çalıştırdığı sorgulara
    //    göre daraltılmıştır. Bir sorgunun döndüreceği HERHANGİ bir doküman
    //    kuralı geçemezse tüm sorgu reddedilir; bu yüzden istemci tarafındaki
    //    filtresiz `matches` dinleyicisi de bu değişiklikle birlikte
    //    taraf bazlı iki sorguya bölünmüştür.

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    /// Güncellemede yalnızca izin verilen alanların değiştiğini doğrular.
    function onlyChanges(allowed) {
      return request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly(allowed);
    }

    /// Yaş alanına dokunuluyorsa 18-99 arasında olmalı.
    function ageIsValidOnWrite() {
      return !('age' in request.resource.data.diff(resource.data).affectedKeys())
             || (request.resource.data.age is int
                 && request.resource.data.age >= 18
                 && request.resource.data.age <= 99);
    }
    // ==========================================================
    // KULLANICILAR
    // ==========================================================
    match /users/{userId} {
      // Profil bilgileri uygulama içinde herkese görünür (check-in listesi,
      // muhtar kartı, sohbet başlığı) ama oturum açmak şarttır.
      allow read: if isSignedIn();

      allow create: if isUser(userId);

      // Kendi dokümanı; ayrıca admin yalnızca elmas alanlarına dokunabilir.
      // 18+ KAPISI sunucu tarafında da zorlanır: yaş alanı değiştiriliyorsa
      // 18-99 aralığında olmak zorunda. İstemci doğrulaması tek başına
      // yeterli değildi (profil düzenleme ekranında hiç kontrol yoktu).
      allow update: if (isUser(userId) && ageIsValidOnWrite())
                    || (isAdmin() && onlyChanges(
                          ['diamonds', 'diamondCount', 'updatedAt']));

      allow delete: if isUser(userId);
    }

    // ==========================================================
    // ŞİFRE SIFIRLAMA — yalnızca Cloud Functions (Admin SDK)
    // ==========================================================
    match /password_reset_codes/{email} {
      allow read, write: if false;
    }

    match /email_verifications/{userId} {
      allow read, write: if isUser(userId);
    }

    match /phone_verifications/{userId} {
      allow read, write: if isUser(userId);
    }

    match /password_verifications/{userId} {
      allow read, write: if isUser(userId);
    }

    // OTP kodları yalnızca Cloud Functions tarafından yönetilir.
    match /otp_codes/{otpId} {
      allow read, write: if false;
    }

    // ==========================================================
    // YASAL ONAYLAR
    // ==========================================================
    // Bu koleksiyonun kuralı hiç yoktu; yazma reddediliyor, hata boş catch'te
    // yutuluyordu. Sonuç: hiçbir kullanıcı için onay kaydı oluşmamıştı.
    match /legal_acceptances/{acceptanceId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ==========================================================
    // CHECK-IN'LER
    // ==========================================================
    match /check_ins/{checkInId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn()
                            && resource.data.userId == request.auth.uid;
      // NOT: Başkasının check-in'ini temizleyen istemci kodu (kapanış saati /
      // sahipsiz kayıt temizliği) artık sessizce no-op olur; bu işi saatlik
      // `cleanupVenueCheckIns` Cloud Function'ı zaten yapıyor.
    }

    match /check_in_history/{historyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
      allow delete: if false; // Temizliği Cloud Function yapar.
    }

    match /favorite_venue_history/{historyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn()
                            && resource.data.userId == request.auth.uid;
    }

    // "Gitmek İstiyorum" listesi — kişisel.
    match /saved_venues/{savedId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn()
                            && resource.data.userId == request.auth.uid;
    }

    // ==========================================================
    // GÖREVLER VE KAMPANYALAR
    // ==========================================================
    // Görev tanımlarını yalnızca Admin SDK yazar; istemci kendine görev
    // uyduramaz veya bir mekan adına kampanya yayınlayamaz.
    match /quests/{questId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Katılım kaydı kullanıcıya aittir. `progress`, `completedAt` ve
    // `redemptionCode` şu an istemciden yazılıyor; kampanya gerçek bir
    // ekonomik değer taşımaya başladığında bu yazımlar Cloud Function'a
    // taşınmalıdır (ilerleme, doğrulanmış check-in'e bağlı olmalı).
    match /quest_participations/{participationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // ==========================================================
    // MEKANLAR
    // ==========================================================
    match /venues/{venueId} {
      // Mekan verisi geneldir (harita, keşif).
      allow read: if true;

      // İstemci eksik mekanı Places verisinden oluşturabilir ama kendini
      // sponsor ilan EDEMEZ. Sponsorluk yalnızca Admin SDK ile verilir.
      allow create: if isAdmin()
                    || (isSignedIn()
                        && (!('isSponsored' in request.resource.data)
                            || request.resource.data.isSponsored == false));

      // Güncellemede sponsorluk alanlarına dokunulamaz (admin hariç:
      // sponsor yönetim paneli admin talebiyle çalışır).
      allow update: if isAdmin()
                    || (isSignedIn()
                    && !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny([
                           'isSponsored', 'sponsorName', 'sponsorLogoUrl',
                           'sponsorBadgeText', 'sponsorPriority',
                           'sponsorStartDate', 'sponsorEndDate',
                           'sponsorDescription', 'sponsorContactInfo',
                           'sponsorPrice', 'sponsorStatus', 'sponsorAddedAt'
                         ]));

      allow delete: if false;
    }

    // Sponsor zincirleri — yalnızca Admin SDK.
    match /sponsored_chains/{chainId} {
      allow read: if true;
      allow write: if false;
    }

    // ==========================================================
    // MUHTARLIK
    // ==========================================================
    match /daily_mayors/{mayorId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      // Muhtarlık devri: yeni muhtar kendisini yazabilir.
      allow update: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if false; // Gece temizliğini Cloud Function yapar.
    }

    match /mayor_transaction_logs/{logId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Terk edilmiş paralel muhtarlık uygulamaları — kod yolu yok, kapalı.
    match /venue_mayors/{venueId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /mayor_bids/{bidId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /venue_mayorships/{venueId} {
      allow read, write: if false;
    }
    match /mayorship_bids/{bidId} {
      allow read, write: if false;
    }

    // ==========================================================
    // ÖDEME / EKONOMİ
    // ==========================================================
    // NOT: Ekonomi hâlâ istemci yetkilidir (kullanıcı kendi elmasını/premium'unu
    // kendi dokümanında güncelleyebilir). Bu, sunucu tarafına taşınmalıdır;
    // buradaki kurallar en azından BAŞKASININ bakiyesine dokunmayı engeller.
    match /diamond_transactions/{transactionId} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /purchases/{purchaseId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /restored_purchases/{restoreId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /premium_subscriptions/{subscriptionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /critical_errors/{errorId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /emergency_fixes/{fixId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ==========================================================
    // BAĞLANTILAR VE MESAJLAR
    // ==========================================================
    // Katılımcı kontrolü: `users` dizisi chat_request akışında yazılıyor,
    // eski kayıtlarda olmayabilir; bu yüzden üç koşul da destekleniyor.
    function isMatchParticipant() {
      return isSignedIn() && (
        resource.data.user1Id == request.auth.uid ||
        resource.data.user2Id == request.auth.uid ||
        (('users' in resource.data) && request.auth.uid in resource.data.users)
      );
    }

    match /matches/{matchId} {
      allow read: if isMatchParticipant();
      allow create: if isSignedIn() && (
        request.resource.data.user1Id == request.auth.uid ||
        request.resource.data.user2Id == request.auth.uid
      );
      allow update, delete: if isMatchParticipant();
    }

    match /messages/{messageId} {
      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow create: if isSignedIn()
                    && request.resource.data.senderId == request.auth.uid;
      // Alıcı yalnızca okundu bilgisini değiştirebilir.
      allow update: if isSignedIn()
                    && resource.data.receiverId == request.auth.uid
                    && onlyChanges(['isRead']);
      allow delete: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
    }

    match /chat_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow create: if isSignedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId != request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.toUserId == request.auth.uid
        && onlyChanges(['status', 'respondedAt']);
      allow delete: if isSignedIn()
        && resource.data.fromUserId == request.auth.uid
        && resource.data.status == 'pending';
    }

    // ==========================================================
    // AKIŞ
    // ==========================================================
    match /feed_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      // Sahibi düzenleyebilir; diğerleri yalnızca beğeni alanına dokunabilir.
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        onlyChanges(['likedBy', 'likeCount'])
      );
      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
    }

    // ==========================================================
    // BİLDİRİMLER
    // ==========================================================
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.fromUserId == request.auth.uid
      );
    }

    // FCM jetonu taşır — istemci yalnızca yazar, asla okumaz.
    match /notification_requests/{requestId} {
      allow read: if false;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ==========================================================
    // GÜVENLİK / MODERASYON
    // ==========================================================
    match /blocked_users/{blockId} {
      allow read: if isSignedIn() && (
        resource.data.blocker == request.auth.uid ||
        resource.data.blocked == request.auth.uid
      );
      allow create: if isSignedIn()
                    && request.resource.data.blocker == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn()
                    && resource.data.blocker == request.auth.uid;
    }

    // Kullanıcının kendi engel listesi (alt koleksiyon).
    // Alt koleksiyonların kuralı hiç yoktu; profilden engelleme bu yüzden
    // sessizce başarısız oluyordu.
    match /users/{userId}/blocked_users/{blockedId} {
      allow read, write: if isUser(userId);
    }

    match /reports/{reportId} {
      // Yalnizca admin okur/listeler; sikayet eden kendi sikayetini de
      // goremez (moderasyon kaydi, tartisma yuzeyi degil).
      allow read, list: if isAdmin();
      allow create: if isSignedIn()
                    && request.resource.data.reporterId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /user_warnings/{warningId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if isAdmin();
    }

    match /user_stats/{userId} {
      allow read: if isSignedIn();
      allow write: if isUser(userId);
    }

    // ==========================================================
    // KULLANIM DIŞI KOLEKSİYONLAR — kapalı
    // ==========================================================
    // Bu koleksiyonlara yazan/okuyan hiçbir canlı kod yolu yok. Açık
    // bırakmanın tek etkisi saldırı yüzeyini büyütmek olurdu.
    match /likes/{likeId}        { allow read, write: if false; }
    match /super_likes/{likeId}  { allow read, write: if false; }
    match /passes/{passId}       { allow read, write: if false; }
    match /blocks/{blockId}      { allow read, write: if false; }

    // ==========================================================
    // YALNIZCA SUNUCU
    // ==========================================================
    match /rtdn_notifications/{notifId} { allow read: if isAdmin(); allow write: if false; }
    match /refund_events/{eventId}      { allow read: if isAdmin(); allow write: if false; }
    match /system_logs/{logId}          { allow read: if isAdmin(); allow write: if false; }
    match /purchase_verifications/{id}  { allow read, write: if false; }
  }
}
