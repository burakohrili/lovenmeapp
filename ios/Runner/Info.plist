<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- IHRACAT SIFRELEME BEYANI
	     Uygulama yalnizca isletim sisteminin sagladigi HTTPS/TLS kullanir
	     (Firebase, Google Places). pubspec.yaml'da hicbir kriptografi
	     paketi yoktur. Bu nedenle muafiyet kapsamindadir.
	     Bu anahtar sayesinde her build'de App Store Connect'te ayrica
	     export compliance sorusu sorulmaz. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>lovenme</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>lovenme</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	
	<!-- FIREBASE URL SCHEMES FOR PHONE AUTH -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.lovenme.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.1056918584333-75c4h7a43b6dkq96c56b6g4hjdu12s13</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.lovenme.app.settings</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>app-settings</string>
			</array>
		</dict>
	</array>
	
	<!-- LOCATION PERMISSIONS -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Bu uygulama yakınındaki mekanları göstermek için konumuna ihtiyaç duyar.</string>
	<!-- ITMS-90683: geolocator ve permission_handler paketleri "Always"
	     konum API'sine referans verdigi icin Apple bu metni zorunlu tutuyor.
	     Uygulama arka planda konum ISTEMIYOR; yalnizca kullanim sirasinda
	     (WhenInUse) konum aliyor. Metin bunu acikca soyluyor. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Lovenme, yalnızca uygulamayı kullanırken yakınındaki mekanları göstermek ve check-in yapabilmen için konumunu kullanır. Arka planda konum takibi yapılmaz.</string>

	
	
	<!-- iOS 14+ için hassas konum izni -->
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>MapLocation</key>
		<string>Haritada konumunuzu göstermek için gerekli</string>
	</dict>
	
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>

	<!-- CAMERA PERMISSIONS -->
	<key>NSCameraUsageDescription</key>
	<string>LoveNMe, profil fotoğrafı çekmek ve mekanlardaki check-in'lerde fotoğraf paylaşmak için kamerayı kullanır.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>LoveNMe needs access to your photo library to select existing photos for your profile. You can choose which photos to share from your gallery.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>LoveNMe saves photos you take within the app to your photo library so you can access them later and share them on other platforms.</string>
	
	<!-- Microphone for video recording - ZORUNLU -->
	<key>NSMicrophoneUsageDescription</key>
	<string>LoveNMe may access the microphone when recording videos to include audio in your shared content.</string>
	
	<!-- iOS 14+ için Photo Library Limited Access -->
	<key>PHPhotoLibraryPreventAutomaticLimitedAccessAlert</key>
	<true/>
	
	<!-- App Category -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.social-networking</string>

	<!-- iOS 17+ Privacy Manifests -->
	<key>NSPrivacyTrackingDomains</key>
	<array></array>
	
	<!-- NETWORK SECURITY -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>googleapis.com</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<false/>
				<key>NSExceptionMinimumTLSVersion</key>
				<string>TLSv1.2</string>
				<key>NSExceptionRequiresForwardSecrecy</key>
				<false/>
			</dict>
			<key>places.googleapis.com</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<false/>
				<key>NSExceptionMinimumTLSVersion</key>
				<string>TLSv1.2</string>
				<key>NSExceptionRequiresForwardSecrecy</key>
				<false/>
			</dict>
		</dict>
	</dict>
	
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>