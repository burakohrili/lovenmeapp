<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- IHRACAT SIFRELEME BEYANI
	     Uygulama yalnizca isletim sisteminin sagladigi HTTPS/TLS kullanir
	     (Firebase, Google Places). pubspec.yaml'da hicbir kriptografi
	     paketi yoktur. Bu nedenle muafiyet kapsamindadir.
	     Bu anahtar sayesinde her build'de App Store Connect'te ayrica
	     export compliance sorusu sorulmaz. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>lovenme</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>lovenme</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	
	<!-- FIREBASE URL SCHEMES FOR PHONE AUTH -->
	<key>CFBundleURLTypes</key>
	<array>
		<!-- Google Sign-In URL semasi KALDIRILDI: uygulamada Google ile giris
		     ozelligi yok (google_sign_in paketi hic kullanilmiyor). Kullanilmayan
		     URL semasi inceleme sorusu doguruyordu. -->
		<dict>
			<key>CFBundleURLName</key>
			<string>com.lovenme.app.settings</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>app-settings</string>
			</array>
		</dict>
	</array>
	
	<!-- LOCATION PERMISSIONS -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Bu uygulama yakınındaki mekanları göstermek için konumuna ihtiyaç duyar.</string>
	<!-- ITMS-90683: geolocator ve permission_handler paketleri "Always"
	     konum API'sine referans verdigi icin Apple bu metni zorunlu tutuyor.
	     Uygulama arka planda konum ISTEMIYOR; yalnizca kullanim sirasinda
	     (WhenInUse) konum aliyor. Metin bunu acikca soyluyor. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Lovenme, yalnızca uygulamayı kullanırken yakınındaki mekanları göstermek ve check-in yapabilmen için konumunu kullanır. Arka planda konum takibi yapılmaz.</string>

	
	
	<!-- NSLocationTemporaryUsageDescriptionDictionary KALDIRILDI:
	     requestTemporaryFullAccuracy hicbir yerde cagrilmiyor. -->
	
	<!-- `fetch` KALDIRILDI: AppDelegate'te arka plan getirme uygulamasi yok
	     (BGTaskScheduler / performFetchWithCompletionHandler yok). Karsiligi
	     olmayan arka plan modu bildirmek belgelenmis bir ret sebebi. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>

	<!-- CAMERA PERMISSIONS -->
	<key>NSCameraUsageDescription</key>
	<string>LoveNMe, profil fotoğrafı çekmek ve mekanlardaki check-in'lerde fotoğraf paylaşmak için kamerayı kullanır.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>LoveNMe, profil fotoğrafını seçebilmen için galerine erişir. Hangi fotoğrafı paylaşacağına sen karar verirsin.</string>
	<!-- NSPhotoLibraryAddUsageDescription KALDIRILDI: uygulama galeriye
	     HICBIR SEY yazmiyor; metin de yanlisti. -->
	
	<!-- Mikrofon: sesli mesaj icin. Eski metin "video kaydederken" diyordu;
	     uygulamada video kaydi yok, sohbette sesli mesaj var. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>LoveNMe, sohbette sesli mesaj kaydedebilmen için mikrofonu kullanır.</string>
	
	<!-- iOS 14+ için Photo Library Limited Access -->
	<key>PHPhotoLibraryPreventAutomaticLimitedAccessAlert</key>
	<true/>
	
	<!-- App Category -->
	<!-- Uygulama metinleri Turkce; bu bildirilmeyince Flutter'in kendi
	     cerceve metinleri (Kes/Kopyala/Yapistir, tarih secici, "Back")
	     Ingilizce geliyordu. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>tr</string>
	</array>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.social-networking</string>

	<!-- iOS 17+ Privacy Manifests -->
	<key>NSPrivacyTrackingDomains</key>
	<array></array>
	
	<!-- NETWORK SECURITY -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>googleapis.com</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<false/>
				<key>NSExceptionMinimumTLSVersion</key>
				<string>TLSv1.2</string>
				<key>NSExceptionRequiresForwardSecrecy</key>
				<false/>
			</dict>
			<key>places.googleapis.com</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<false/>
				<key>NSExceptionMinimumTLSVersion</key>
				<string>TLSv1.2</string>
				<key>NSExceptionRequiresForwardSecrecy</key>
				<false/>
			</dict>
		</dict>
	</dict>
	
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>